              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('joseClienteId', body.clienteId);",
                  "pm.test('Nombre es Jose Lema', function () { pm.expect(body.nombre).to.eql('Jose Lema'); });"
